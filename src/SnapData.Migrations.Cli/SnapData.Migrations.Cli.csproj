<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>snapdata</ToolCommandName>
    <AssemblyName>SnapData.Migrations.Cli</AssemblyName>
    <RootNamespace>SnapData.Migrations.Cli</RootNamespace>
    <PackageId>SnapData.Migrations.Cli</PackageId>
    <Title>SnapData Migrations CLI</Title>
    <Authors>Edin</Authors>
    <Copyright>Copyright © 2026 Edin</Copyright>
    <Version>0.4.0</Version>
    <Description>Command-line tools for SnapData migrations.</Description>
    <PackageTags>database;migrations;cli;snapdata</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/edin/SnapData</PackageProjectUrl>
    <RepositoryUrl>https://github.com/edin/SnapData</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pin patched transitive SqlClient dependencies for each supported target. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="FirebirdSql.Data.FirebirdClient" Version="10.3.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Ini" Version="10.0.10" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0"
                      PrivateAssets="All" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="MySqlConnector" Version="2.6.1" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
    <ProjectReference Include="..\SnapData.Migrations\SnapData.Migrations.csproj" />
  </ItemGroup>

</Project>
